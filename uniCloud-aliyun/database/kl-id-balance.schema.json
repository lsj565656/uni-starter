{
  "bsonType": "object",
  "required": ["user_id", "type", "amount", "balance", "create_date"],
  "permission": {
    "read": "doc.user_id == auth.uid",
    "create": "auth.uid != null",
    "update": "doc.user_id == auth.uid",
    "delete": "doc.user_id == auth.uid"
  },
  "properties": {
    "_id": {
      "description": "记录ID，系统自动生成"
    },
    "user_id": {
      "bsonType": "objectId",
      "title": "用户ID",
      "foreignKey": "uni-id-users._id"
    },
    "type": {
      "bsonType": "int",
      "enum": [1, 2, 3, 4, 5],
      "title": "变动类型",
      "description": "1:收入 2:支出 3:任务担保支出 4:任务返还收入 5:充值获得"
    },
    "amount": {
      "bsonType": "number",
      "title": "变动金额（正数，前端根据type判断加减）"
    },
    "balance": {
      "bsonType": "number",
      "title": "变动后余额"
    },
    "order_no": {
      "bsonType": "string",
      "title": "业务订单号",
      "description": "关联业务订单的唯一标识"
    },
    "transaction_id": {
      "bsonType": "string",
      "title": "支付流水号",
      "description": "第三方支付平台的交易流水号"
    },
    "task_id": {
      "bsonType": "string",
      "title": "任务ID"
    },
    "comment": {
      "bsonType": "string",
      "title": "备注"
    },
    "create_date": {
      "bsonType": "timestamp",
      "title": "创建时间",
      "defaultValue": {
        "$env": "now"
      }
    }
  },
  "indexes": [
    {
      "IndexName": "user_balance_index",
      "MgoKeySchema": {
        "MgoIndexKeys": [
          {
            "Name": "user_id",
            "Direction": "1"
          },
          {
            "Name": "create_date",
            "Direction": "-1"
          }
        ]
      }
    },
    {
      "IndexName": "order_no_unique",
      "MgoKeySchema": {
        "MgoIndexKeys": [
          {
            "Name": "order_no",
            "Direction": "1"
          }
        ],
        "MgoIsUnique": true
      }
    }
  ]
}