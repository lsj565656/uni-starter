{
  "bsonType": "object",
  "required": ["user_id", "nickname", "avatar", "is_active", "show_fields", "created_at", "updated_at"],
  "properties": {
    "_id": { "bsonType": "string", "description": "主键，用户ID" },
    "user_id": { "bsonType": "string", "description": "用户ID" },
    "nickname": { "bsonType": "string", "description": "昵称" },
    "avatar": { "bsonType": "string", "description": "头像URL" },
    "gender": { "bsonType": "string", "enum": ["male", "female", "other"], "description": "性别" },
    "age": { "bsonType": "int", "description": "年龄" },
    "education": { "bsonType": "string", "description": "学历" },
    "city": { "bsonType": "string", "description": "常驻城市" },
    "skills": { "bsonType": "array", "items": { "bsonType": "string" }, "description": "技能标签" },
    "strengths": { "bsonType": "string", "description": "个人长处描述" },
    "tags": { "bsonType": "array", "items": { "bsonType": "string" }, "description": "擅长领域标签" },
    "photos": { "bsonType": "array", "items": { "bsonType": "string" }, "description": "个人照片URL数组" },
    "diploma_photos": { "bsonType": "array", "items": { "bsonType": "string" }, "description": "毕业证书图片URL" },
    "certificate_photos": { "bsonType": "array", "items": { "bsonType": "string" }, "description": "职业技能证书图片URL" },
    "show_fields": {
      "bsonType": "object",
      "description": "字段展示控制",
      "properties": {
        "age": { "bsonType": "bool" },
        "gender": { "bsonType": "bool" },
        "education": { "bsonType": "bool" },
        "city": { "bsonType": "bool" },
        "skills": { "bsonType": "bool" },
        "strengths": { "bsonType": "bool" },
        "tags": { "bsonType": "bool" },
        "photos": { "bsonType": "bool" }
      }
    },
    "is_active": { "bsonType": "bool", "description": "是否在趴活广场展示" },
    "allow_homepage_view": { "bsonType": "bool", "description": "是否允许主页展示趴活信息" },
    "created_at": { "bsonType": "date", "description": "创建时间" },
    "updated_at": { "bsonType": "date", "description": "更新时间" }
  }
}